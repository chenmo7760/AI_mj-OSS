{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Keyframe Record",
  "type": "object",
  "required": ["shot_id", "version", "start_frame", "end_frame", "review_status"],
  "properties": {
    "shot_id": { "type": "string" },
    "version": { "type": "integer" },
    "start_frame": { "type": ["string", "null"] },
    "end_frame": { "type": ["string", "null"] },
    "previous_end_frame": { "type": ["string", "null"] },
    "next_start_frame": { "type": ["string", "null"] },
    "review_status": { "type": "string" },
    "review_file": { "type": ["string", "null"] }
  }
}
