{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review",
  "type": "object",
  "required": ["review_id", "target_type", "reviewer", "result", "required_fixes", "accepted_risks", "next_role", "created_at"],
  "properties": {
    "schema_version": { "type": "string" },
    "review_id": { "type": "string" },
    "target_type": { "type": "string" },
    "target_id": { "type": ["string", "null"] },
    "target_file": { "type": ["string", "null"] },
    "stage": { "type": ["string", "null"] },
    "reviewer": { "type": "string" },
    "result": { "type": "string", "enum": ["Pass", "Needs Fix", "Blocked", "Needs Human Decision"] },
    "blocking_findings": { "type": "array", "items": { "type": "string" } },
    "required_fixes": { "type": "array", "items": { "type": "string" } },
    "accepted_risks": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "stale": { "type": "boolean" },
    "next_role": { "type": ["string", "null"] },
    "created_at": { "type": "string" }
  }
}
