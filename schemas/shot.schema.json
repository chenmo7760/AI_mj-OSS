{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storyboard Shots",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["shot_id", "episode", "order", "duration_sec", "scene", "characters", "action", "camera", "source_events", "continuity_from", "continuity_to", "status"],
    "properties": {
      "shot_id": { "type": "string" },
      "episode": { "type": "string" },
      "order": { "type": "integer" },
      "title": { "type": ["string", "null"] },
      "style_profile_id": { "type": ["string", "null"] },
      "duration_sec": { "type": "number" },
      "location": { "type": ["string", "null"] },
      "time": { "type": ["string", "null"] },
      "atmosphere": { "type": ["string", "null"] },
      "scene": { "type": "string" },
      "scene_title": { "type": ["string", "null"] },
      "scene_description": { "type": ["string", "null"] },
      "lighting": { "type": ["string", "null"] },
      "color_palette": { "type": ["string", "null"] },
      "characters": { "type": "array", "items": { "type": "string" } },
      "character_ids": { "type": "array", "items": { "type": "string" } },
      "action": { "type": "string" },
      "result": { "type": ["string", "null"] },
      "dialogue": { "type": "string" },
      "dialogues": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["sequence", "character_id", "text"],
          "properties": {
            "sequence": { "type": "integer" },
            "character_id": { "type": "string" },
            "speaker": { "type": ["string", "null"] },
            "text": { "type": "string" },
            "emotion": { "type": ["string", "null"] },
            "start_ratio": { "type": ["number", "null"] },
            "end_ratio": { "type": ["number", "null"] }
          }
        }
      },
      "narration": { "type": "string" },
      "camera": { "type": "string" },
      "shot_type": { "type": ["string", "null"] },
      "angle": { "type": ["string", "null"] },
      "movement": { "type": ["string", "null"] },
      "camera_direction": { "type": ["string", "null"] },
      "composition_guide": { "type": ["string", "null"] },
      "focal_point": { "type": ["string", "null"] },
      "depth_of_field": { "type": ["string", "null"] },
      "motion_script": { "type": ["string", "null"] },
      "video_script": { "type": ["string", "null"] },
      "image_prompt": { "type": ["string", "null"] },
      "video_prompt": { "type": ["string", "null"] },
      "bgm_prompt": { "type": ["string", "null"] },
      "sound_effect": { "type": ["string", "null"] },
      "sound_design": { "type": ["string", "null"] },
      "music_cue": { "type": ["string", "null"] },
      "transition_in": { "type": ["string", "null"] },
      "transition_out": { "type": ["string", "null"] },
      "reference_image_prompts": { "type": "array", "items": { "type": "string" } },
      "reference_images": { "type": "array", "items": { "type": "object" } },
      "costume_overrides": { "type": "object" },
      "source_events": { "type": "array", "items": { "type": "string" } },
      "scene_asset_ids": { "type": "array", "items": { "type": "string" } },
      "prop_asset_ids": { "type": "array", "items": { "type": "string" } },
      "continuity_from": { "type": ["string", "null"] },
      "continuity_to": { "type": ["string", "null"] },
      "keyframes": { "type": "object" },
      "prompt_files": { "type": "object" },
      "prompt_versions": { "type": "object" },
      "assets": { "type": "object" },
      "quality_gate": { "type": "object" },
      "frozen_version": { "type": ["string", "null"] },
      "status": { "type": "string" }
      ,
      "route_plan": { "type": "object" },
      "stale": { "type": "boolean" },
      "stale_reason": { "type": ["string", "null"] }
    }
  }
}
