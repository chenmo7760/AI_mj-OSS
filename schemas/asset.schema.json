{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assets",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["asset_id", "type", "version", "source", "selected"],
    "properties": {
      "asset_id": { "type": "string" },
      "type": { "type": "string" },
      "style_profile_id": { "type": ["string", "null"] },
      "variant_id": { "type": ["string", "null"] },
      "sequence_in_type": { "type": ["integer", "null"] },
      "is_active": { "type": ["boolean", "null"] },
      "selected_image_id": { "type": ["string", "null"] },
      "shot_id": { "type": ["string", "null"] },
      "episode_id": { "type": ["string", "null"] },
      "version": { "type": "integer" },
      "asset_version": { "type": ["integer", "null"] },
      "path": { "type": ["string", "null"] },
      "source": { "type": "string" },
      "provider": { "type": ["string", "null"] },
      "model": { "type": ["string", "null"] },
      "generation_mode": { "type": ["string", "null"] },
      "reference_mode": { "type": ["string", "null"] },
      "provider_task_id": { "type": ["string", "null"] },
      "provider_request_id": { "type": ["string", "null"] },
      "prompt_file": { "type": ["string", "null"] },
      "candidate_group_id": { "type": ["string", "null"] },
      "candidate_index": { "type": ["integer", "null"] },
      "candidate_rank": { "type": ["integer", "null"] },
      "duration_sec_actual": { "type": ["number", "null"] },
      "width": { "type": ["integer", "null"] },
      "height": { "type": ["integer", "null"] },
      "fps": { "type": ["number", "null"] },
      "checksum": { "type": ["string", "null"] },
      "last_frame_url": { "type": ["string", "null"] },
      "meta": { "type": "object" },
      "scope": { "type": ["string", "null"] },
      "parent_asset_id": { "type": ["string", "null"] },
      "inherits_from": { "type": "array", "items": { "type": "string" } },
      "grid_cell": { "type": "object" },
      "stale": { "type": "boolean" },
      "stale_reason": { "type": ["string", "null"] },
      "quality_score": { "type": "object" },
      "selected": { "type": "boolean" },
      "rejected_reason": { "type": ["string", "null"] },
      "review_file": { "type": ["string", "null"] },
      "quality_notes": { "type": ["string", "null"] },
      "created_at": { "type": "string" }
    }
  }
}
